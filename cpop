#!/usr/bin/env bash
# cpop - run any command and copy its output to the system clipboard.
# Usage: cpop [flags] <command> [args...]      e.g.  cpop -m ls -l
set -u

VERSION="1.1.0"

usage() {
  cat <<USAGE
cpop $VERSION - copy the output of any command to the system clipboard

Usage:
  cpop [flags] <command> [args...]

Format flags (change what lands on the clipboard; the terminal shows raw output):
  -t, --table      aligned box-drawn table
  -m, --markdown   Markdown table (paste into GitHub, Slack, Notion...)
  -j, --json       JSON: table -> array of objects, anything else -> array of lines
                   (output that is already JSON is just pretty-printed)
  -p, --pretty     best guess: pretty-print if JSON, otherwise a box-drawn table
  -c, --code       wrap in a Markdown code fence (combine with any of the above)
  -r, --raw        keep ANSI colors instead of stripping them

Other:
  -q, --quiet      hide the banner (same as CPOP_QUIET=1)
  -h, --help       show this help
  -V, --version    show version

Examples:
  cpop ls -a
  cpop -m df -h
  cpop -j ps aux
  cpop -pc curl -s https://api.github.com/zen
  cpop -t sh -c 'ls | head'    (quote pipelines so they run inside cpop)

Table modes split columns on whitespace; the first full-width line is the header
and any extra words are kept in the last column. Stdout and stderr are captured,
and the command's exit code is preserved. Format flags need python3.
USAGE
}

fmt=""; code=0; raw=0; quiet="${CPOP_QUIET:-}"
set_fmt() {
  if [ -n "$fmt" ] && [ "$fmt" != "$1" ]; then
    echo "cpop: only one of -t/-m/-j/-p can be used at a time" >&2; exit 2
  fi
  fmt="$1"
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "cpop $VERSION"; exit 0 ;;
    --table) set_fmt table ;;
    --markdown) set_fmt markdown ;;
    --json) set_fmt json ;;
    --pretty) set_fmt pretty ;;
    --code) code=1 ;;
    --raw) raw=1 ;;
    --quiet) quiet=1 ;;
    --) shift; break ;;
    --*) echo "cpop: unknown flag: $1 (try --help)" >&2; exit 2 ;;
    -?*)
      # bundled short flags, e.g. -mc
      for ((i = 1; i < ${#1}; i++)); do
        case "${1:i:1}" in
          t) set_fmt table ;;
          m) set_fmt markdown ;;
          j) set_fmt json ;;
          p) set_fmt pretty ;;
          c) code=1 ;;
          r) raw=1 ;;
          q) quiet=1 ;;
          h) usage; exit 0 ;;
          V) echo "cpop $VERSION"; exit 0 ;;
          *) echo "cpop: unknown flag: -${1:i:1} (try --help)" >&2; exit 2 ;;
        esac
      done ;;
    *) break ;;
  esac
  shift
done

if [ $# -eq 0 ]; then usage >&2; exit 2; fi

# Pick a clipboard backend. Prefer the one matching the current session.
clip_cmd=()
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
  clip_cmd=(wl-copy)
elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
  clip_cmd=(xclip -selection clipboard)
elif [ -n "${DISPLAY:-}" ] && command -v xsel >/dev/null 2>&1; then
  clip_cmd=(xsel --clipboard --input)
elif command -v pbcopy >/dev/null 2>&1; then
  clip_cmd=(pbcopy)
elif command -v clip.exe >/dev/null 2>&1; then
  clip_cmd=(clip.exe)
elif command -v wl-copy >/dev/null 2>&1; then
  clip_cmd=(wl-copy)
elif command -v xclip >/dev/null 2>&1; then
  clip_cmd=(xclip -selection clipboard)
fi

if [ "${#clip_cmd[@]}" -eq 0 ]; then
  echo "cpop: no clipboard tool found. Install one of: wl-clipboard, xclip, xsel" >&2
  exit 127
fi

if ! command -v "$1" >/dev/null 2>&1; then
  echo "cpop: command not found: $1" >&2
  exit 127
fi

if [ -n "$fmt" ] && ! command -v python3 >/dev/null 2>&1; then
  echo "cpop: -t/-m/-j/-p need python3, which was not found" >&2
  exit 127
fi

# Is the terminal UTF-8? (glyphs in the banner and table borders)
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) utf=1 ;;
  *) utf=0 ;;
esac

tmp="$(mktemp)" || exit 1
out="$(mktemp)" || exit 1
trap 'rm -f "$tmp" "$out"' EXIT

# Run the command, showing output live while capturing stdout+stderr.
"$@" 2>&1 | tee "$tmp"
status=${PIPESTATUS[0]}

if [ ! -s "$tmp" ]; then
  [ -z "$quiet" ] && echo "cpop: command produced no output, clipboard unchanged" >&2
  exit "$status"
fi

# Strip ANSI color/control sequences so the clipboard holds plain text.
if [ "$raw" -eq 1 ]; then cp "$tmp" "$out"; else sed -E 's/\x1b\[[0-9;?]*[A-Za-z]//g' "$tmp" > "$out"; fi

format() {
  read -r -d '' pycode <<'PY' || true
import sys, json, re, unicodedata
mode, ascii_only = sys.argv[1], sys.argv[2] == "1"
text = sys.stdin.read()
lines = text.rstrip("\n").split("\n")

def width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else (0 if unicodedata.combining(c) else 1) for c in s)

def pad(s, w):
    return s + " " * (w - width(s))

def as_json(t):
    try:
        return json.loads(t)
    except ValueError:
        return None

def parse_table(lines):
    """Split on whitespace. Returns (preamble, header, rows) or None if not tabular."""
    rows = [l.split() for l in lines if l.strip()]
    if len(rows) < 2:
        return None
    counts = {}
    for r in rows[1:]:   # data rows decide the width; the header may contain multi-word names
        counts[len(r)] = counts.get(len(r), 0) + 1
    # most common width, preferring the wider one on ties
    n = max(counts, key=lambda k: (counts[k], k))
    if n < 2:
        return None
    pre, body = [], []
    for l in lines:
        if not l.strip():
            continue
        f = l.split(None, n - 1)
        if not body and len(f) < n:
            pre.append(l)
        else:
            body.append(f + [""] * (n - len(f)))
    if len(body) < 2:
        return None
    return pre, body[0], body[1:]

def box(header, rows):
    w = [max(width(r[i]) for r in [header] + rows) for i in range(len(header))]
    if ascii_only:
        tl, tm, tr, ml, mm, mr, bl, bm, br, h, v = "+", "+", "+", "+", "+", "+", "+", "+", "+", "-", "|"
    else:
        tl, tm, tr, ml, mm, mr, bl, bm, br, h, v = "┌┬┐├┼┤└┴┘─│"
    def rule(l, m, r):
        return l + m.join(h * (x + 2) for x in w) + r
    def row(r):
        return v + v.join(" " + pad(c, w[i]) + " " for i, c in enumerate(r)) + v
    out = [rule(tl, tm, tr), row(header), rule(ml, mm, mr)]
    out += [row(r) for r in rows]
    out.append(rule(bl, bm, br))
    return out

def md(header, rows):
    esc = lambda c: c.replace("|", "\\|")
    header, rows = [esc(c) for c in header], [[esc(c) for c in r] for r in rows]
    w = [max(3, max(width(r[i]) for r in [header] + rows)) for i in range(len(header))]
    line = lambda r: "| " + " | ".join(pad(c, w[i]) for i, c in enumerate(r)) + " |"
    return [line(header), "| " + " | ".join("-" * x for x in w) + " |"] + [line(r) for r in rows]

def emit(ls):
    sys.stdout.write("\n".join(ls) + "\n")

parsed = as_json(text)
tab = parse_table(lines)
if mode == "json" or (mode == "pretty" and parsed is not None):
    if parsed is not None:
        data = parsed
    elif mode == "json" and tab:
        pre, header, rows = tab
        keys, seen = [], {}
        for k in header:
            seen[k] = seen.get(k, 0) + 1
            keys.append(k if seen[k] == 1 else "%s_%d" % (k, seen[k]))
        data = [dict(zip(keys, r)) for r in rows]
    else:
        data = lines
    emit([json.dumps(data, indent=2, ensure_ascii=False)])
elif mode in ("table", "pretty", "markdown"):
    if not tab:
        sys.stderr.write("cpop: output is not tabular, copying as-is\n")
        sys.stdout.write(text)
    else:
        pre, header, rows = tab
        emit(pre + ([""] if pre else []) + (md if mode == "markdown" else box)(header, rows))
else:
    sys.stdout.write(text)
PY
  python3 -c "$pycode" "$fmt" "$((1 - utf))" < "$out"
}

label=""
if [ -n "$fmt" ]; then
  fmt_out="$(mktemp)" || exit 1
  trap 'rm -f "$tmp" "$out" "$fmt_out"' EXIT
  if format > "$fmt_out"; then mv "$fmt_out" "$out"; label="$fmt"; else
    echo "cpop: formatting failed, copying raw output" >&2
  fi
fi

if [ "$code" -eq 1 ]; then
  { echo '```'; cat "$out"; [ -n "$(tail -c1 "$out")" ] && echo; echo '```'; } > "$out.code" && mv "$out.code" "$out"
  label="${label:+$label + }code"
fi

# Redirect the backend's output so it can't hold our terminal open.
"${clip_cmd[@]}" < "$out" >/dev/null 2>&1 &
clip_pid=$!
wait "$clip_pid"
clip_status=$?

if [ "$clip_status" -ne 0 ]; then
  echo "cpop: failed to write to the clipboard (${clip_cmd[0]} exited $clip_status)" >&2
  exit 1
fi

if [ -z "$quiet" ]; then
  lines=$(wc -l < "$out" | tr -d ' ')
  if [ -n "$(tail -c1 "$out")" ]; then lines=$((lines + 1)); fi
  # the raw output may have ended without a newline; keep the banner on its own line
  [ -n "$(tail -c1 "$tmp")" ] && echo >&2
  bytes=$(wc -c < "$out" | tr -d ' ')
  [ "$lines" -eq 1 ] && unit="line" || unit="lines"

  if [ "$utf" -eq 1 ]; then bolt="⚡"; tick="✔"; arrow="➜"; dot="·"; rule="────────────────────────────────────────"
  else bolt="*"; tick="v"; arrow="->"; dot="-"; rule="----------------------------------------"; fi

  # Colors only when stderr is a terminal and NO_COLOR is unset.
  if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    m=$'\e[1;35m'; c=$'\e[1;36m'; g=$'\e[1;32m'; d=$'\e[2m'; y=$'\e[1;33m'; r=$'\e[0m'
  else
    m=""; c=""; g=""; d=""; y=""; r=""
  fi

  tag=""; [ -n "$label" ] && tag=" ${d}${dot}${r} ${y}${label}${r}"
  printf '%s\n' "${d}${rule}${r}" >&2
  printf '%s\n' "${m}${bolt} CPOP ${bolt}${r} ${g}${tick} copied${r} ${c}${lines} ${unit}${r} ${d}${dot} ${bytes} B${r}${tag} ${arrow} ${g}clipboard${r}" >&2
fi
exit "$status"
